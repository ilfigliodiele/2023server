<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Rec Room is an IL2CPP game and MelonLoader 0.6 is distributed as release zips on its GitLab,
      not as a NuGet package, so there is nothing to PackageReference. Point MelonLoaderDir at an
      extracted MelonLoader_Latest_x64.zip (the directory holding MelonLoader.dll and 0Harmony.dll)
      or set MelonLoaderDir in a Directory.Build.props next to this file.

      The reference is Compile-only and Private=false on purpose: the game folder already provides
      these assemblies, and shipping copies alongside the mod is how you end up with two MelonLoaders
      loaded in one process.
    -->
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(MSBuildThisFileDirectory)..\..\melonloader\</MelonLoaderDir>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RecEmu.ClientMod</AssemblyName>
    <RootNamespace>RecEmu.ClientMod</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail loudly and early: an unresolved Reference produces a wall of CS0246 errors about
       MelonLogger and MelonMod, which reads like broken source rather than a missing path. -->
  <Target Name="VerifyMelonLoaderReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(MelonLoaderDir)MelonLoader.dll')"
           Text="MelonLoader.dll not found. Set MelonLoaderDir to the directory containing MelonLoader.dll and 0Harmony.dll (currently tried: $(MelonLoaderDir))." />
  </Target>

</Project>